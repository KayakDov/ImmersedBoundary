digraph FastPoisson {
    //ranksep=1.1;
    nodesep=0.6;
    fontsize=24;
    labelloc=t;
    rankdir=TB;

    node [shape=box, fontname="Helvetica", style=filled, fillcolor="#ffffff"];

    // External / Interop Layer
    Fortran_API [label="Fortran Application Layer\n(CFD Engine Core)", shape=component, fillcolor="#fff3e0"];
    C_Bridge [shape=ellipse, fillcolor="#fff3e0"];

    // Core API Layer
    Poisson [label="Poisson Interface\n(Public API Bound)", penwidth=2.5];
    Laplacian1d [label="Laplacian1d Operators"];
    Laplacian [label="Laplacian (2D / 3D Matrices)"];

    // Configuration / Traits Layer
    Boundary [label="BoundaryConfig<Real, SegX, SegY, SegZ>\nCompile-Time Axis Traits\n• Dirichlet (DST / Sine Math)\n• Neumann (DCT / Cosine Math)\n• Staggered Grid Stencils"];

    // High Performance Solvers
    EigenSolver [label="EigenDecompSolver"];
    Eigen2D [label="EigenDecomp2d"];
    Eigen3D [label="EigenDecomp3d"];
    EigenThomas [penwidth=2, color="#0d47a1"];

    // Mathematical Decomposition Node
    KroneckerTripletEigenVecs [label="Kronecker Triplet\n• Analytical 1D Eigenpairs\n• O(N) Dimension Reduction", fillcolor="#f9fbe7"];

    // Native GPU Kernels
    K_eVals [label="eValsLInvMultKernel", shape=invhouse, fillcolor="#ede7f6"];
    K_Thomas [label="solveThomas3dLap", shape=invhouse, fillcolor="#ede7f6"];

    // Pipeline Linkage
    Boundary -> Laplacian1d [color=red];
    Boundary -> Laplacian [color=red];
    Laplacian1d -> EigenThomas [color=red];
    
    Boundary -> KroneckerTripletEigenVecs [color=purple];
    KroneckerTripletEigenVecs -> EigenSolver [color=red];

    // Infrastructure & Validation
    GTest [shape=note, style=filled, fillcolor="#f5f5f5", label="Google Test Suite\n Epsilon Norm Convergence Testing"];
    GH_Actions [shape=folder, style=filled, fillcolor="#e1f5fe", label="GitHub Actions Matrix\nWindows Compilation"];

    // --- Relationships & Mappings ---

    // Interop Pipeline
    Fortran_API -> C_Bridge [color=darkorange, penwidth=2, label=" Inter-language Call"];
    C_Bridge -> Poisson [color=darkorange];

    // Structure Dependency
    Poisson -> Boundary [color=red];   

    // Template Lineage
    EigenSolver -> Eigen2D [color=blue];
    EigenSolver -> Eigen3D [color=blue];
    EigenSolver -> EigenThomas [color=blue];

    // Core Solver -> Native Kernel Dispatch
    Eigen2D -> K_eVals [color=purple, style=bold];
    Eigen3D -> K_eVals [color=purple, style=bold];
    EigenThomas -> K_Thomas [color=purple, style=bold];

    // Automated Systems Validation
    GTest -> Poisson [color=green];
    GH_Actions -> Poisson [color=green];

    // Legend Block
    Legend [
        shape=none
        fontsize=12
        margin=0.1
        label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD><FONT COLOR="darkorange"><B>━━▷</B></FONT></TD><TD>Polyglot Interoperability Bindings</TD></TR>
            <TR><TD><FONT COLOR="blue"><B>━━▷</B></FONT></TD><TD>Template Inheritance / Specialization</TD></TR>
            <TR><TD><FONT COLOR="red"><B>━━▷</B></FONT></TD><TD>Composition / Architectural Usage</TD></TR>
            <TR><TD><FONT COLOR="purple"><B>━━▷</B></FONT></TD><TD>Asynchronous CUDA Kernel Launch</TD></TR>
            <TR><TD><FONT COLOR="green"><B>━━▷</B></FONT></TD><TD>Automated Verification Path</TD></TR>
        </TABLE>
        >
    ];
}
