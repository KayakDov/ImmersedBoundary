// Fresh Fortran/C++ runs with matching inputs and format-aware comparisons.
#include <gtest/gtest.h>
#include "GoldenSupport.h"
#include <chrono>
#include <iostream>

#ifndef CFD_CPP_EXE
#define CFD_CPP_EXE "CFD_CPP_EXE_NOT_SET"
#endif
#ifndef CFD_FORTRAN_EXE
#define CFD_FORTRAN_EXE "CFD_FORTRAN_EXE_NOT_SET"
#endif
#ifndef CFD_FORTRAN_BASE_CONV
#define CFD_FORTRAN_BASE_CONV "CFD_FORTRAN_BASE_CONV_NOT_SET"
#endif
#ifndef CFD_GOLDEN_CONFIG_DIR
#define CFD_GOLDEN_CONFIG_DIR "CFD_GOLDEN_CONFIG_DIR_NOT_SET"
#endif

namespace {
using namespace cfd_golden;
struct GoldenScenario { std::string name, cppConfigFileName; bool timeAveraging = false; };

std::vector<GoldenScenario> discoverGoldenScenarios() {
    std::vector<GoldenScenario> scenarios;
    const fs::path dir(CFD_GOLDEN_CONFIG_DIR);
    const std::string suffix = ".cpp.json";
    if (!fs::is_directory(dir)) return scenarios;
    for (const auto& entry : fs::directory_iterator(dir)) {
        const auto name = entry.path().filename().string();
        if (entry.is_regular_file() && name.size() > suffix.size() &&
            name.compare(name.size() - suffix.size(), suffix.size(), suffix) == 0) {
            // Read each scenario's own time_averaging.enabled so the test
            // body below knows, per scenario, whether to also check the
            // _av family -- those files are legitimately empty (and would
            // fail readTable's "no data" check) whenever averaging is off.
            const bool ta = readJson(entry.path())
                .value("time_averaging", Json::object()).value("enabled", false);
            scenarios.push_back({name.substr(0, name.size() - suffix.size()), name, ta});
        }
    }
    std::sort(scenarios.begin(), scenarios.end(),
        [](const GoldenScenario& a, const GoldenScenario& b) { return a.name < b.name; });
    return scenarios;
}

int runCommand(const std::string& command, const fs::path& cwd) {
    return std::system(("cd " + shellQuote(cwd) + " && " + command).c_str());
}

class GoldenValueTest : public ::testing::TestWithParam<GoldenScenario> {};

TEST_P(GoldenValueTest, MatchesFortranReference) {
    const auto& scenario = GetParam();
    ASSERT_TRUE(fs::is_regular_file(CFD_CPP_EXE)) << "Set CFD_CPP_EXE to the C++ executable";
    ASSERT_TRUE(fs::is_regular_file(CFD_FORTRAN_EXE)) << "Set CFD_FORTRAN_EXE to the Fortran executable";
    ASSERT_TRUE(fs::is_regular_file(CFD_FORTRAN_BASE_CONV)) << "Set CFD_FORTRAN_BASE_CONV to Conv.dat";
    const auto root = uniqueRunDirectory(scenario.name);
    const auto cppDir = root / "cpp", fortranDir = root / "fortran";
    fs::create_directory(cppDir);
    fs::create_directory(fortranDir);
    SCOPED_TRACE("Scenario " + scenario.name + "; retained inputs, outputs and logs: " + root.string());
    std::cout << "Golden comparison files: " << root << std::endl;

    Json config = readJson(fs::path(CFD_GOLDEN_CONFIG_DIR) / scenario.cppConfigFileName);
    config["output"]["directory"] = cppDir.string();
    const auto cppConfig = cppDir / "config.json";
    writeText(cppConfig, config.dump(2) + "\n");
    // Render and validate ALL inputs before either expensive solver starts.
    writeText(fortranDir / "Conv.dat", renderConvDat(config, CFD_FORTRAN_BASE_CONV));
    const auto fortranStart = std::chrono::steady_clock::now();
    ASSERT_EQ(0, runCommand(shellQuote(fs::absolute(CFD_FORTRAN_EXE)) + " > " +
        shellQuote(fortranDir / "run.log") + " 2>&1", fortranDir)) << "Fortran failed; inspect run.log";
    const double fortranSeconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - fortranStart).count();

    const auto echo = verifyFortranEcho(fortranDir / "Conv.out", config);
    ASSERT_EQ(0u, echo.mismatches) << echo.summary();

    const auto cppStart = std::chrono::steady_clock::now();
    ASSERT_EQ(0, runCommand(shellQuote(fs::absolute(CFD_CPP_EXE)) + " " + shellQuote(cppConfig) + " > " +
        shellQuote(cppDir / "run.log") + " 2>&1", cppDir)) << "C++ failed; inspect run.log";
    const double cppSeconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - cppStart).count();

    // The GPU port's entire reason to exist is speed, not just correctness
    // (data stays resident on the GPU across iterations, every physics/
    // solver step runs as a kernel, instead of Fortran's per-step CPU work)
    // -- so a slower cfdSolver is a regression worth failing the build over,
    // same as a wrong number would be. EXPECT, not ASSERT: a timing miss
    // shouldn't hide whether the output was also still correct.
    std::cout << "Timing (" << scenario.name << "): Fortran=" << fortranSeconds << "s  cfdSolver="
        << cppSeconds << "s  speedup=" << (fortranSeconds / cppSeconds) << "x" << std::endl;
    EXPECT_LE(cppSeconds, fortranSeconds) << "cfdSolver (" << cppSeconds << "s) was slower than Fortran ("
        << fortranSeconds << "s) for scenario " << scenario.name;

    std::vector<std::string> files = {"Conv.out", "History.dat", "Serie.dat", "Psi_Yaverage.dat", "Tmpr_Yaverage.dat"};
    if (scenario.timeAveraging) {
        // finalizeTimeAverage()'s in-place substitution already means the
        // five files above reflect the time-averaged state when this flag
        // is on (that path gets exercised either way) -- these four add
        // direct coverage of the _av family's own writers. Deliberately
        // NOT included: Amplitudes.dat (a different column count per
        // configured frequency; compareTables assumes exactly 3 columns)
        // and Average_velocity.ddd (gfortran unformatted-binary, not
        // Tecplot text at all) -- both need their own comparator, not
        // written yet.
        for (const char* f : {"Tmpr_av.dat", "Vx_av.dat", "Vy_av.dat", "Vz_av.dat"}) files.push_back(f);
    }
    for (const std::string& file : files) {
        try {
            Comparison result;
            const bool avFamily = file.size() > 7 && file.compare(file.size() - 7, 7, "_av.dat") == 0;
            if (file == "Conv.out") {
                // See compareReports()'s own skipLabels doc comment: when
                // averaging is on, Fortran double-counts Teta's
                // contribution to exactly these two numbers (its own
                // substitution runs before they're computed, and they
                // already have their own analytic Teta term); cfdSolver's
                // number is the internally-consistent one here, not
                // Fortran's.
                std::vector<std::string> skip;
                if (scenario.timeAveraging) skip = {"Nusselt number", "Midplane Nusselt number"};
                result = compareReports(fortranDir / file, cppDir / file, skip);
            }
            else if (avFamily) result = compareTables3D(fortranDir / file, cppDir / file);
            else result = compareTables(fortranDir / file, cppDir / file, file.find("Yaverage") != std::string::npos);
            EXPECT_EQ(0u, result.mismatches) << file << ": " << result.summary();
        } catch (const std::exception& e) {
            ADD_FAILURE() << file << ": " << e.what();
        }
    }
}

INSTANTIATE_TEST_SUITE_P(
    NonRedundantConfigurations, GoldenValueTest, ::testing::ValuesIn(discoverGoldenScenarios()),
    [](const ::testing::TestParamInfo<GoldenScenario>& info) { return info.param.name; });
} // namespace
